import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        int number;

        System.out.print("Enter a number not greater than 30: ");
        number = input.nextInt();

        if (number <= 0 || number > 30) {
            System.out.println("Invalid input. Please enter a number from 1 to 30.");
        } else {
            System.out.println("\nNumbers:");

            for (int i = 1; i <= number; i++) {

                // Skip number 7
                if (i == 7) {
                    continue;
                }

                System.out.println(i);

                // Stop the loop at number 30
                if (i == 30) {
                    break;
                }
            }
        }

        input.close();
    }
}
